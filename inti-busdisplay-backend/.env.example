# Port HTTP server. Samakan dengan BACKEND_PORT di .env aplikasi Flutter.
PORT=3000

# 0.0.0.0 supaya HP di jaringan WiFi yang sama bisa mengakses server.
HOST=0.0.0.0

# Lokasi file database SQLite (dibuat otomatis).
DB_PATH=./data/busdisplay.db

# Masa berlaku kredensial BLE per device (hari). Device yang dicabut masih bisa
# mengontrol panel paling lama selama ini. Kunci per panel dikelola dengan
# "npm run panels:add", bukan di file ini.
CREDENTIAL_TTL_DAYS=7

# Masa berlaku kode pairing (menit).
PAIRING_CODE_TTL_MINUTES=15

# Isi bila server di belakang reverse proxy HTTPS (lihat README "Deploy").
# "loopback" = proxy di mesin yang sama; angka = jumlah hop proxy.
TRUST_PROXY=
