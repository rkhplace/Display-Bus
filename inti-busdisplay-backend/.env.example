# Port HTTP server. Samakan dengan BACKEND_PORT di .env aplikasi Flutter.
PORT=3000

# 0.0.0.0 supaya HP di jaringan WiFi yang sama bisa mengakses server.
HOST=0.0.0.0

# Lokasi file database SQLite (dibuat otomatis).
DB_PATH=./data/busdisplay.db

# Kunci AES-256 untuk payload BLE, base64 dari 32 byte acak.
# Buat dengan: npm run ble:keygen
# Kunci yang SAMA harus di-flash ke firmware ESP32 panel P5.
BLE_KEY=

# Masa berlaku kode pairing (menit).
PAIRING_CODE_TTL_MINUTES=15
