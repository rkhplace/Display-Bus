# Salin menjadi .env (file .env wajib ada karena didaftarkan sebagai asset di pubspec.yaml).
# File ini ikut terbungkus ke dalam APK, jadi JANGAN isi dengan rahasia apa pun.

# IP laptop/server backend di jaringan WiFi yang sama dengan HP.
# Nilainya dicetak oleh backend saat "npm start".
BACKEND_IP=192.168.1.10
BACKEND_PORT=3000

# "http" untuk demo di LAN tanpa TLS; "https" jika backend sudah di belakang HTTPS.
BACKEND_SCHEME=http
